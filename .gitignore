
# Python caches
__pycache__/
*.pyc

# Secrets (HF tokens, ssh passwords, agent keys) — never commit
env.sh

# Editable-install build artifacts
*.egg-info/

# Owner scratch artifacts (kept local by decision)
owner_tasks/setup_logs/

# Machine-pinned recipes (auto-pin namespace). Curated recipes under
# recipes/quant/*.json ARE tracked; recipes/quant/auto/ is per-machine KB the
# pipeline writes on GO runs — promote to curated by hand, don't commit raw.
/recipes/quant/auto/

# Reproduce run outputs (aqa reproduce's default ./reproduce/ directory)
/reproduce/
