+_ATTENTION_DIM_ATTRS = ("num_attention_heads", "num_key_value_heads", "head_dim")
+
+
+def _attn_config_scope(config: PretrainedConfig) -> PretrainedConfig:
+    """Return the config level that actually declares the attention dims.
+
+    Composite (vision-language / nested) configs such as Qwen3_5 keep
+    `num_attention_heads` / `num_key_value_heads` / `head_dim` / `hidden_size`
+    only on the nested `text_config`, and transformers' composite config does
+    NOT proxy those attributes onto the root. Static KV/attention qparam
+    initialisation reads them off the root and raises, so descend one level
+    when the root declares none of them. Flat configs are returned unchanged.
+    """
+    if any(hasattr(config, a) for a in _ATTENTION_DIM_ATTRS):
+        return config
+    sub = getattr(config, "text_config", None)
+    if sub is not None and any(hasattr(sub, a) for a in _ATTENTION_DIM_ATTRS):
+        return sub
+    return config
+
