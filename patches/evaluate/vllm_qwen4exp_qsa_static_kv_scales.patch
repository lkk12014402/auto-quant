+        # A serialized main-cache scale is remapped onto the QSA owner's `_k_scale`
+        # buffer above, but the QSA kernel reads the *host* copies (`_k_scale_float`)
+        # that set_default_quant_scales() initialized to 1.0 -- and no quant method is
+        # attached to refresh them, because both compressed-tensors and ModelOpt gate
+        # their KV-cache method on `isinstance(layer, Attention)` while QSA owns the
+        # cache directly. Without this sync a checkpoint's static KV scales load and
+        # are then ignored, i.e. the run silently keeps scale=1.0 while *looking*
+        # correct, so also log what landed.
+        synced: list[tuple[float, float]] = []
+        for module in self.modules():
+            if not isinstance(module, Qwen4ExpQSAAttention):
+                continue
+            for cache, host, cpu_copy in (
+                ("_k_scale", "_k_scale_float", "_k_scale_cpu"),
+                ("_v_scale", "_v_scale_float", "_v_scale_cpu"),
+            ):
+                buf = getattr(module, cache, None)
+                if buf is None:
+                    continue
+                # `attn_head` strategies serialize one scale per head; the host
+                # scalar the kernel uses follows vLLM's existing convention of
+                # taking the max over them.
+                value = float(buf.detach().to("cpu").max().item())
+                setattr(module, host, value)
+                cpu = getattr(module, cpu_copy, None)
+                if cpu is not None:
+                    cpu.fill_(value)
+            synced.append((module._k_scale_float, module._v_scale_float))
+        if synced:
+            ks = [k for k, _ in synced]
+            vs = [v for _, v in synced]
+            logger.info_once(
+                "Qwen4Exp QSA: applied checkpoint static KV-cache scales on %d "
+                "layer(s); k=[%.6g..%.6g] v=[%.6g..%.6g]",
+                len(synced), min(ks), max(ks), min(vs), max(vs),
+            )
+            if all(k == 1.0 and v == 1.0 for k, v in synced):
+                # The artifact declared a KV scheme but no scale reached the layers:
+                # serving would silently use scale=1.0, which is exactly the
+                # "looks fine, measures wrong" failure mode. Say it out loud.
+                logger.warning_once(
+                    "Qwen4Exp QSA: checkpoint declares a KV-cache scheme but every "
+                    "k/v scale is still 1.0 -- the checkpoint likely does not ship "
+                    "self_attn.{k,v}_scale for these layers, so FP8 KV runs with "
+                    "unit scales."
+                )
         return loaded
 
 
